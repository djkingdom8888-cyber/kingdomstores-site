# Copy this file to .env and fill in real values.
# .env is where secrets live — never commit it, never paste these values into chat.

# --- Stripe (test-mode keys to start: https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From the Stripe CLI or Dashboard > Developers > Webhooks, after you register
# POST {your-domain}/api/webhooks/stripe as an endpoint listening for checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# --- Shipping (only needed once physical merch is added — digital tracks don't ship) ---
# One of: shippo | easypost
SHIPPING_PROVIDER=
SHIPPING_API_KEY=

# Ship-from address used when requesting rates/labels
SHIP_FROM_NAME=Kingdom Stores
SHIP_FROM_STREET1=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_ZIP=
SHIP_FROM_COUNTRY=US

# --- App ---
# Set to "production" once this is live on a real domain over HTTPS — it makes the
# admin session cookie HTTPS-only (required) and requires KS_SECRET_KEY be set below
# (a fresh random key on every restart would log every admin out on each deploy).
FLASK_ENV=development

# Required when FLASK_ENV=production. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Keep it the same across restarts/deploys, and never share or commit it.
KS_SECRET_KEY=

# Only used by `python app.py` directly (gunicorn/Passenger set these via the host
# platform instead). Leave as-is for local dev.
HOST=127.0.0.1
PORT=8843
